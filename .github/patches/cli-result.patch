+// Retain only the final four bytes; stream all other output without truncation.
+// A missing/invalid trailer (including a crashed recovery) is a failure.
+static int read_command_result(int fd) {
+	unsigned char buffer[516];
+	size_t pending = 0;
+	for (;;) {
+		ssize_t count = read(fd, buffer + pending, sizeof(buffer) - pending);
+		if (count < 0 && errno == EINTR) continue;
+		if (count < 0) { perror("Reading recovery result"); return 1; }
+		if (count == 0) break;
+		pending += static_cast<size_t>(count);
+		if (pending > 4) {
+			const size_t emit = pending - 4;
+			if (fwrite(buffer, 1, emit, stdout) != emit) return 1;
+			fflush(stdout);
+			memmove(buffer, buffer + emit, 4);
+			pending = 4;
+		}
+	}
+	if (pending == 4 && buffer[0] == 0 && buffer[1] == 'T' &&
+		buffer[2] == 'W' && buffer[3] <= 1)
+		return buffer[3];
+	fwrite(buffer, 1, pending, stdout);
+	fprintf(stderr, "Recovery closed the command without a valid result.\n");
+	return 1;
 }
 
