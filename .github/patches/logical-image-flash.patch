+            return false;
+        }
+        gui_msg(Msg("flashing=Flashing {1}...")(Display_Name));
+        if (!WriteLogicalImage(full_filename, Actual_Block_Device, part_settings)) {
+            gui_err("logical_img_failed=Logical image flash failed; see recovery log");
