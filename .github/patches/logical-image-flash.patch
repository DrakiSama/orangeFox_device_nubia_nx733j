+            gui_err("logical_img_metadata=Mount metadata before flashing a logical image");
+            return false;
+        }
+        auto ota_lock = LockLogicalImageOTA();
+        if (!ota_lock.ok()) {
+            gui_err("logical_img_ota=OTA state is busy or could not be verified; boot Android and finish updates first");
+            return false;
+        }
+        std::string name = Mount_Point == "/system_root" ? "system" : Mount_Point.substr(1);
+#ifdef AB_OTA_UPDATER
+        name += PartitionManager.Get_Active_Slot_Suffix();
+#endif
+        if (!CheckLogicalImageMapping(name, Actual_Block_Device)) {
+            gui_err("logical_img_mapping=Target is not the selected slot's direct linear mapping on super");
+            return false;
+        }
