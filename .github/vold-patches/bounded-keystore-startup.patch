+// Recovery must reach the UI even if vendor keystore dependencies cannot load.
+// No keys are generated or changed here; a missing service remains a crypto error.
+static ::ndk::SpAIBinder WaitForRecoveryKeystore() {
+    constexpr int attempts = 40;
+    for (int attempt = 0; attempt < attempts; ++attempt) {
+        auto* service = AServiceManager_checkService(keystore2_service_name);
+        if (service) return ::ndk::SpAIBinder(service);
+        if (attempt + 1 < attempts)
+            std::this_thread::sleep_for(std::chrono::milliseconds(250));
+    }
+    LOG(ERROR) << "Recovery keystore2 unavailable after bounded startup polling; data remains locked.";
+    return {};
+}
