on init
    start vendor.boot-qti
    setprop prepdecrypt.setpatch true

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    mkdir /tmp/persist 0775 shell system
    mount none /tmp/persist /mnt/vendor/persist bind rec

on boot
    setprop sys.usb.config adb

# vendor_dlkm mount + módulos + servicios
# OrangeFox (fox_12.1) también usa la propiedad twrp.modules.loaded al terminar
# KernelModuleLoader::Load_Vendor_Modules; es el punto donde zte_tpd.ko y
# aw9620x.ko ya están cargados, así que el daemon de touch arranca aquí.
# (twrp.variant.files_copied no existe en OrangeFox y nunca dispararía.)
on property:twrp.modules.loaded=true
    exec_background u:r:recovery:s0 -- /system/bin/sh /sbin/mount_vendor_dlkm.sh
    # Firmware modem
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    symlink /firmware /vendor/firmware_mnt
    start vendor.recovery-hardware
    start vendor.recovery-cpu
    # touch daemon
    start ztethp

# Decryption uses the existing KeyMint/Gatekeeper setup; no odm.prepdecrypt service exists.

on property:servicemanager.ready=true
    setprop sys.boot_completed 1

# Keep vendor.qti.vibrator disabled; UI uses direct Awinic sysfs haptics.

on post-fs
    # nop

# Keep the scripts in /sbin: mounting stock /vendor must not hide them during
# startup. The recovery ramdisk has no /sbin/sh, so every hook runs the shell
# at /system/bin/sh explicitly. The service environment keeps explicit recovery
# paths and stdio_to_kmsg so command/linker errors stay visible instead of an
# exit 127 from an anonymous exec with discarded stderr.
service vendor.recovery-hardware /system/bin/sh /sbin/init_nx733j_hardware.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
    setenv PATH /sbin:/system/bin
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64/hw
    setenv LD_CONFIG_FILE /system/etc/ld.config.txt
    stdio_to_kmsg

# Thermal discovery must continue even when ADSP is unavailable.
service vendor.recovery-cpu /system/bin/sh /sbin/init_nx733j_cpu.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
    setenv PATH /sbin:/system/bin
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64/hw
    setenv LD_CONFIG_FILE /system/etc/ld.config.txt
    stdio_to_kmsg
