on init
    start vendor.keymint-qti

service vendor.keymint-qti /system/bin/sh /sbin/nx733j-keymint.sh
    class early_hal
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64/nx733j-compat:/vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
