# TWRP v1 syntax: mount_point filesystem block_device flags=...
# EROFS partitions are image-flash targets, not file-based backup/restore targets.
/system_root erofs system flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/system_ext erofs system_ext flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/product erofs product flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/vendor erofs vendor flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/odm erofs odm flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/vendor_dlkm erofs vendor_dlkm flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/system_dlkm erofs system_dlkm flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/boot emmc /dev/block/by-name/boot flags=slotselect;backup=1;flashimg=1;canbewiped=0;wipeingui=0
/boot_a emmc /dev/block/by-name/boot_a flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/boot_b emmc /dev/block/by-name/boot_b flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/vendor_boot emmc /dev/block/by-name/vendor_boot flags=slotselect;backup=1;flashimg=1;canbewiped=0;wipeingui=0
/vendor_boot_a emmc /dev/block/by-name/vendor_boot_a flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/vendor_boot_b emmc /dev/block/by-name/vendor_boot_b flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/init_boot emmc /dev/block/by-name/init_boot flags=slotselect;backup=1;flashimg=1;canbewiped=0;wipeingui=0
/init_boot_a emmc /dev/block/by-name/init_boot_a flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/init_boot_b emmc /dev/block/by-name/init_boot_b flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/recovery emmc /dev/block/by-name/recovery flags=slotselect;backup=1;flashimg=1;canbewiped=0;wipeingui=0
/recovery_a emmc /dev/block/by-name/recovery_a flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/recovery_b emmc /dev/block/by-name/recovery_b flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/dtbo emmc /dev/block/by-name/dtbo flags=slotselect;backup=1;flashimg=1;canbewiped=0;wipeingui=0
/dtbo_a emmc /dev/block/by-name/dtbo_a flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/dtbo_b emmc /dev/block/by-name/dtbo_b flags=backup=0;flashimg=1;canbewiped=0;wipeingui=0
/data f2fs /dev/block/by-name/userdata flags=backup=1;flashimg=0;storage;wipeingui
/metadata f2fs /dev/block/by-name/metadata flags=backup=0;flashimg=0;wipeingui=0
/persist ext4 /dev/block/by-name/persist flags=backup=1;flashimg=0;canbewiped=0;wipeingui=0
/firmware vfat /dev/block/by-name/modem flags=slotselect;backup=0;flashimg=0;canbewiped=0;wipeingui=0
/misc emmc /dev/block/by-name/misc flags=backup=0;flashimg=0;canbewiped=0;wipeingui=0
/persistent emmc /dev/block/by-name/frp flags=backup=0;flashimg=0;canbewiped=0;wipeingui=0
/vbmeta emmc /dev/block/by-name/vbmeta flags=slotselect;backup=1;flashimg=0;canbewiped=0;wipeingui=0
/vbmeta_system emmc /dev/block/by-name/vbmeta_system flags=slotselect;backup=1;flashimg=0;canbewiped=0;wipeingui=0
